# Browser requests stay same-origin; no secret belongs in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=/api/v1
# Server-only development upstream; production edge routing is deployment-owned.
API_INTERNAL_URL=http://127.0.0.1:8000

# Canonical public origin; set to the actual HTTPS site before deployment.
SITE_URL=http://localhost:3000

# Private Next-to-API read budget credential, shared by both apps; never NEXT_PUBLIC.
CATALOG_INTERNAL_READ_KEY=

# Exact HTTPS CDN / S3 upload origins, comma-separated; build-time CSP allowlist.
CSP_ASSET_ORIGINS=
