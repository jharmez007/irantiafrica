APP_NAME="IRANTI Africa"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=iranti_local
DB_USERNAME=iranti
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
# Local/UAT only: PostgreSQL session idle expiry in minutes. Production remains
# on its separately approved environment policy; do not copy this value blindly.
SESSION_LIFETIME=1440
AUTH_STAFF_IDLE_SECONDS=86400
AUTH_STAFF_ABSOLUTE_SECONDS=86400
AUTH_STAFF_MFA_TRUST_SECONDS=86400
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=63790
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=63791
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_PREFIX=iranti_local_
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

MAIL_MAILER=array
# For Render pre-launch and production, select the native HTTPS/API driver:
# MAIL_MAILER=resend with RESEND_API_KEY set privately in Render.
RESEND_API_KEY=
# Local staff invitations: use either LOCAL_MAILPIT_ENABLED=true below, or
# set MAIL_MAILER=smtp with a real host, port, sender and private credentials.
# Testing always uses array mail. Never commit actual SMTP credentials.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=hello@example.test
MAIL_FROM_NAME="${APP_NAME}"
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Catalog originals remain private. Production requires s3 and an owned HTTPS CDN.
CATALOG_DISK=local
CATALOG_MEDIA_ORIGIN=

# Private Next-to-API read budget credential, shared by both apps; never NEXT_PUBLIC.
CATALOG_INTERNAL_READ_KEY=

# Engineering default; no in-place reservation extension.
INVENTORY_RESERVATION_TTL_SECONDS=900
# Local code defaults to a representative UAT threshold of 5; testing/production default to 0.
# Set INVENTORY_LOW_STOCK_THRESHOLD explicitly only with owner-approved environment policy.

# Approved configurable cart defaults; ordinary carts do not reserve stock.
CART_MAX_QUANTITY=99
CART_MAX_LINES=100
CART_GUEST_RETENTION_DAYS=30

# Phase 3G: absolute guest order capability lifetime; reads never renew it.
ORDER_GUEST_ACCESS_SECONDS=86400

# Hosted Paystack redirect. Backend secret only; leave disabled until configured.
PAYMENTS_ENABLED=false
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
PAYSTACK_LIVE_APPROVED=false

# Exact client-approved tracking hostnames, comma-separated; no wildcard or scheme.
# Empty fails closed for tracking links and dispatch until logistics is configured.
SHIPPING_TRACKING_HOSTS=

# Refund transport stays off until privately configured and verified.
REFUNDS_ENABLED=false
PAYSTACK_REFUNDS_LIVE_APPROVED=false

# Transactional mail: disabled until intentionally configured. Local/tests force array sink.
TRANSACTIONAL_EMAIL_ENABLED=false
TRANSACTIONAL_EMAIL_START_AT=
MAIL_REPLY_TO_ADDRESS=
MAIL_STAGING_RECIPIENT=

# Production requires verify-full and the provider CA file where not system-trusted.
DB_SSLROOTCERT=
# Per-minute defaults are documented in config/limits.php (RATE_* overrides).

# Production managed Redis TLS: set both schemes to tls; optional provider CA paths.
REDIS_SCHEME=tcp
REDIS_CACHE_SCHEME=tcp
REDIS_TLS_CA=
REDIS_CACHE_TLS_CA=

# Optional native Mailpit capture: local only, fixed 127.0.0.1:1025
LOCAL_MAILPIT_ENABLED=false
